# Copy to .env for local development (npm run dev). Docker users can set these
# in docker-compose.yml instead. Never commit .env.

# Optional: a random string of at least 32 characters. Leave empty and Zedgerr
# generates one and stores it in DATA_DIR. Generate your own with: openssl rand -hex 32
JWT_SECRET=

# Port the server listens on.
PORT=3000

# Folder for the SQLite database, uploaded files and the generated secret.
DATA_DIR=./data

# "true" lets anyone create an account. The very first account can always be created.
ALLOW_REGISTRATION=false

# "true" when running behind a reverse proxy (nginx, Caddy, Traefik) so rate limiting sees the real client IP.
TRUST_PROXY=false

# Only needed if another domain calls the API directly. Comma-separated list of origins.
CORS_ORIGIN=

# Optional: OpenAI-compatible endpoint for the "Improve with AI" button.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# SMTP is configured in the app under Settings → Notifications.
# No environment variables needed.
