# Copy this file to .env and fill in the values. Never commit .env.

# Required in production: random string of at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Port the server listens on.
PORT=3000

# Folder for the SQLite database and uploaded files.
DATA_DIR=./data

# "true" lets anyone create an account. The very first account can always be created.
ALLOW_REGISTRATION=false

# "true" when running behind a reverse proxy (nginx, Caddy, Traefik) so rate limiting sees the real client IP.
TRUST_PROXY=false

# Only needed if another domain calls the API directly. Comma-separated list of origins.
CORS_ORIGIN=

# Optional: OpenAI-compatible endpoint for the "Improve with AI" button.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: Telegram notifications for upcoming subscription payments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
