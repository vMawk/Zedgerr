# Kopieer dit bestand naar .env en vul de waarden in.
# .env wordt nooit gecheckt in git (zie .gitignore).

# Verplicht: willekeurige string van minimaal 32 tekens
JWT_SECRET=change-me-to-a-long-random-secret-string

# Poort waarop de Node.js server luistert (default: 3000)
PORT=3000

# Map voor SQLite-database en geüploade bestanden (default: ./data)
DATA_DIR=./data

# Zet op "true" om iedereen toe te staan een account aan te maken
ALLOW_REGISTRATION=false

# Optioneel: OpenAI-compatible API key voor AI-suggesties
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
